# ───────────────────────────────────────────
# Asaas — Pagamento / assinaturas recorrentes
# ───────────────────────────────────────────
# Obtenha em: Asaas → Configurações → Integrações → Chave de API
ASAAS_API_KEY=sua_api_key_aqui

# Token do Webhook (OBRIGATÓRIO p/ segurança).
# No Asaas → Configurações → Webhooks: crie um webhook, defina um "Token de
# autenticação" e use o MESMO valor aqui. O Asaas envia esse token no header
# `asaas-access-token`. Sem isto o webhook é recusado (anti-fraude).
ASAAS_WEBHOOK_TOKEN=defina_um_token_forte_aqui

# URL da API do Asaas. Padrão = produção. Para testar use o sandbox:
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3

# ───────────────────────────────────────────
# Supabase — Banco de dados
# ───────────────────────────────────────────
# URL do projeto (server-side). Use a URL do SEU projeto Supabase.
SUPABASE_URL=https://evrscfmdbguruwjcckfw.supabase.co

# Service Role Key (NÃO expor no front-end! Somente server-side)
# Obtenha em: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ───────────────────────────────────────────
# Groq — IA de suporte (chat)
# ───────────────────────────────────────────
# Obtenha em: https://console.groq.com → API Keys
GROQ_API_KEY=sua_groq_api_key_aqui

# ───────────────────────────────────────────
# URL pública da aplicação
# ───────────────────────────────────────────
APP_URL=http://localhost:4000
# Em produção: APP_URL=https://seudominio.com

# ───────────────────────────────────────────
# CORS — origens permitidas (produção). Separe por vírgula.
# ───────────────────────────────────────────
# CORS_ORIGINS=https://seudominio.com
