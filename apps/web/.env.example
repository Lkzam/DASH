# ───────────────────────────────────────────
# AbacatePay — Sistema de pagamento
# ───────────────────────────────────────────
# Obtenha em: https://app.abacatepay.com → Configurações → API Keys
ABACATEPAY_API_KEY=sua_api_key_aqui

# ───────────────────────────────────────────
# Supabase — Banco de dados
# ───────────────────────────────────────────
# URL já está no supabaseClient.js, mas para os routes server-side:
SUPABASE_URL=https://tuedlrtbnlguhnudttac.supabase.co

# Service Role Key (NÃO expor no front-end! Somente server-side)
# Obtenha em: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ───────────────────────────────────────────
# URL pública da aplicação (usada no returnUrl do AbacatePay)
# ───────────────────────────────────────────
APP_URL=http://localhost:4000
# Em produção: APP_URL=https://seudominio.com
