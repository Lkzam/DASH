# ───────────────────────────────────────────
# AbacatePay — Sistema de pagamento
# ───────────────────────────────────────────
# Obtenha em: https://app.abacatepay.com → Configurações → API Keys
ABACATEPAY_API_KEY=sua_api_key_aqui

# Segredo do Webhook (OBRIGATÓRIO p/ segurança).
# Configure o MESMO valor no painel da AbacatePay → Webhooks.
# Sem isto o webhook é recusado, evitando ativação de plano forjada.
ABACATEPAY_WEBHOOK_SECRET=defina_um_segredo_forte_aqui

# ───────────────────────────────────────────
# Supabase — Banco de dados
# ───────────────────────────────────────────
# URL do projeto (server-side). Use a URL do SEU projeto Supabase.
SUPABASE_URL=https://evrscfmdbguruwjcckfw.supabase.co

# Service Role Key (NÃO expor no front-end! Somente server-side)
# Obtenha em: Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ───────────────────────────────────────────
# Groq — IA de suporte (chat)
# ───────────────────────────────────────────
# Obtenha em: https://console.groq.com → API Keys
GROQ_API_KEY=sua_groq_api_key_aqui

# ───────────────────────────────────────────
# URL pública da aplicação (usada no returnUrl do AbacatePay)
# ───────────────────────────────────────────
APP_URL=http://localhost:4000
# Em produção: APP_URL=https://seudominio.com

# ───────────────────────────────────────────
# CORS — origens permitidas (produção). Separe por vírgula.
# ───────────────────────────────────────────
# CORS_ORIGINS=https://seudominio.com
